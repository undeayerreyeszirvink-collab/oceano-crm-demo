# AI-Native CRM 环境变量配置模板
# 复制此文件为 .env.local 并填入实际值

# ============================================================
# 数据库配置 (PostgreSQL / Supabase)
# ============================================================

# Supabase 项目 URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase 匿名公钥 (用于客户端)
SUPABASE_ANON_KEY=your-anon-key

# Supabase 服务端密钥 (仅用于服务端，切勿暴露给客户端)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 数据库直连 URL (用于迁移和 CLI 工具)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ============================================================
# Redis 配置 (BullMQ 消息队列)
# ============================================================

# Redis 连接 URL
REDIS_URL=redis://localhost:6379

# Redis 密码 (如果有)
# REDIS_PASSWORD=your-redis-password

# ============================================================
# 用友 BIP API 配置
# ============================================================

# BIP API 基础 URL
BIP_API_BASE_URL=https://api.bip.com/v1

# BIP API 密钥
BIP_API_KEY=your-bip-api-key

# BIP API 密钥 ID
BIP_API_SECRET=your-bip-api-secret

# BIP 租户 ID
BIP_TENANT_ID=your-tenant-id

# ============================================================
# 企业微信配置
# ============================================================

# 企业 ID
WECOM_CORP_ID=your-corp-id

# 应用 AgentId
WECOM_AGENT_ID=1000001

# 应用 Secret
WECOM_SECRET=your-app-secret

# 消息回调 Token
WECOM_TOKEN=your-callback-token

# 消息回调 EncodingAESKey
WECOM_ENCODING_AES_KEY=your-encoding-aes-key

# ============================================================
# OpenClaw 配置
# ============================================================

# OpenClaw API 端点
OPENCLAW_API_URL=http://localhost:3001

# OpenClaw API 密钥
OPENCLAW_API_KEY=your-openclaw-api-key

# ============================================================
# LLM 配置
# ============================================================

# OpenAI API 密钥 (用于 GPT 模型)
# OPENAI_API_KEY=sk-your-openai-key

# Anthropic API 密钥 (用于 Claude 模型)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# 默认 LLM 模型
# LLM_MODEL=gpt-4-turbo

# ============================================================
# 应用配置
# ============================================================

# 应用环境 (development | staging | production)
NODE_ENV=development

# 应用端口
PORT=3000

# 应用基础 URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# 监控配置 (可选)
# ============================================================

# Prometheus 指标端口
# METRICS_PORT=9090

# Sentry DSN (错误追踪)
# SENTRY_DSN=https://your-sentry-dsn

# ============================================================
# 日志配置
# ============================================================

# 日志级别 (debug | info | warn | error)
LOG_LEVEL=info

# ============================================================
# 安全配置
# ============================================================

# JWT 密钥 (用于会话签名)
JWT_SECRET=your-jwt-secret-change-in-production

# Cookie 加密密钥
COOKIE_SECRET=your-cookie-secret-change-in-production

# ============================================================
# 熔断器配置 (可选覆盖默认值)
# ============================================================

# BIP 熔断器配置
# BIP_CIRCUIT_FAILURE_THRESHOLD=3
# BIP_CIRCUIT_RECOVERY_TIMEOUT=60000
# BIP_CIRCUIT_TIMEOUT=5000

# 企微熔断器配置
# WECOM_CIRCUIT_FAILURE_THRESHOLD=5
# WECOM_CIRCUIT_RECOVERY_TIMEOUT=30000
# WECOM_CIRCUIT_TIMEOUT=3000

# LLM 熔断器配置
# LLM_CIRCUIT_FAILURE_THRESHOLD=2
# LLM_CIRCUIT_RECOVERY_TIMEOUT=120000
# LLM_CIRCUIT_TIMEOUT=30000
